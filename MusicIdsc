            CopyBtn.Parent = Item
            
            CopyBtn.MouseButton1Click:Connect(function()
                setclipboard(tostring(songId))
                CopyBtn.Text = "Copied!"
                task.wait(1)
                CopyBtn.Text = "Copy"
            end)
            
            if LocalPlayer.Name == ADMIN_USER then
                local DeleteBtn = Instance.new("TextButton")
                DeleteBtn.Size = UDim2.new(0, 55, 0, 25)
                DeleteBtn.Position = UDim2.new(1, -125, 0, 10)
                DeleteBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
