            AddedByLabel.Font = Enum.Font.Gotham
            AddedByLabel.TextSize = 11
            AddedByLabel.Text = "Added by: " .. (addedByName or "Unknown")
            AddedByLabel.Parent = Item
            
            local CopyBtn = Instance.new("TextButton")
            CopyBtn.Size = UDim2.new(0, 60, 0, 25)
            CopyBtn.Position = UDim2.new(1, -65, 0, 10)
            CopyBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
