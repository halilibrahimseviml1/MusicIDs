            ScrollArea.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
        end

        SearchBar:GetPropertyChangedSignal("Text"):Connect(function()
            local query = string.lower(SearchBar.Text)
            for _, item in ipairs(ScrollArea:GetChildren()) do
                if item:IsA("Frame") then
                    local info = item:FindFirstChild("InfoLabel")
                    if info then
                        if query == "" or string.find(string.lower(info.Text), query) then
                            item.Visible = true
                        else
                            item.Visible = false
                        end
                    end
                end
            end
            ScrollArea.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
        end)

        loadSongs = function()
            for _, v in ipairs(ScrollArea:GetChildren()) do
                if v:IsA("Frame") then v:Destroy() end
            end
            
            task.spawn(function()
                local success, response = pcall(function() return game:HttpGet(API_URL) end)
                if success and response then
                    local decodedSuccess, data = pcall(function()
                        return HttpService:JSONDecode(response)
                    end)
                    
                    if decodedSuccess and type(data) == "table" then
                        for _, song in ipairs(data) do
                            local sName = song.name or "Unknown"
                            local addedBy = song.addedBy or "Unknown"
                            local uId = song.userId or 1
                            local dbKey = song._id or song.id
                            
                            addSongUI(song.id, sName, addedBy, uId, dbKey)
                        end
                    end
                end
            end)
        end

        AddBtn.MouseButton1Click:Connect(function()
            local sName = NameInput.Text
            local sId = IDInput.Text
            
            if sName == "" or sName:match("^%s*$") then return end
            if sId == "" or not tonumber(sId) then return end
            
            if tick() - lastAddTick < 60 then
                AddBtn.Text = "Wait 1m!"
                task.wait(1.5)
                AddBtn.Text = "Add"
                return
            end
            
            local exists = false
            local success, response = pcall(function() return game:HttpGet(API_URL) end)
            if success and response then
                local decodedSuccess, data = pcall(function() return HttpService:JSONDecode(response) end)
                if decodedSuccess and type(data) == "table" then
                    for _, song in ipairs(data) do
                        if tostring(song.id) == tostring(sId) or string.lower(tostring(song.name)) == string.lower(tostring(sName)) then
                            exists = true
                            break
                        end
                    end
                end
            end
            
            if exists then
                AddBtn.Text = "Exists!"
                task.wait(1.5)
                AddBtn.Text = "Add"
                return
            end
            
            lastAddTick = tick()
            
            local payload = HttpService:JSONEncode({
                name = sName, 
                id = sId,
                addedBy = LocalPlayer.Name,
                userId = tostring(LocalPlayer.UserId)
            })
            
            task.spawn(function()
                pcall(function()
                    request({ 
                        Url = API_URL, 
                        Method = "POST", 
                        Headers = {["Content-Type"] = "application/json"}, 
                        Body = payload 
                    })
                end)
                task.wait(0.5)
                loadSongs()
            end)
            IDInput.Text = ""
            NameInput.Text = ""
        end)

